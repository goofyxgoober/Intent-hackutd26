NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
# Live IntentFlow backend mode (points frontend terminal and graph to FastAPI)
NEXT_PUBLIC_INTENTFLOW_API=/api
NEXT_PUBLIC_INTENTFLOW_WS=ws://localhost:8000/api

# Query and Jev settings
QUERY_PLANNER_MAX_FILES=8
QUERY_MAX_ROUNDS=2
QUERY_OUTLINE_TOKEN_BUDGET=3000
QUERY_CONTEXT_TOKEN_BUDGET=10000
QUERY_SOURCE_MAX_LINES_PER_FILE=120
QUERY_SOURCE_MAX_TOTAL_LINES=400
QUERY_ANSWER_PROVIDER=nemotron
QUERY_FALLBACK_TO_GEMINI=true
CHAT_GENERATION_TIMEOUT_SECONDS=120
NEMOTRON_TIER_QUERY_ANSWER=fast

