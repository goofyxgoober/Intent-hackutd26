# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=read:user repo
OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
FRONTEND_URL=http://localhost:3000
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Reject GitHub accounts without two-factor authentication
REQUIRE_GITHUB_2FA=true

# SQLite file for users, connected repos and intent graphs
DATABASE_PATH=intentflow.db

# Secret you also enter when adding the webhook on GitHub (any long random string)
GITHUB_WEBHOOK_SECRET=

# Export commits the intent folder here; never the default branch
INTENT_BRANCH=intentflow/intents
INTENT_FOLDER=.intentflow

# Each connected repo's intent folder lives under DATA_DIR/workspaces/<id>/intent
DATA_DIR=data

# Agent API keys as role:key pairs (roles: builder, test_runner, engine). Keys need 16+ chars.
# Generate one with: openssl rand -hex 24
AGENT_KEYS=

# Polling: check the default branch for new commits every N seconds while the repo is in use (0 = off)
POLL_INTERVAL_SECONDS=30
POLL_IDLE_STOP_SECONDS=1800

# Webhook pushes within this many seconds are handled as one batch
SYNC_DEBOUNCE_SECONDS=20

# Composition references: "peer_children" (spec default) or "any"
REFERENCE_SCOPE=peer_children

# Agent 2: Google Gemini Copilot & Invariant Test Orchestrator
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Two-Mode Terminal (Query <-> Hypothesis Generation)
NVIDIA_API_KEY=
QUERY_PLANNER_MAX_FILES=8
QUERY_MAX_ROUNDS=2
QUERY_OUTLINE_TOKEN_BUDGET=3000
QUERY_CONTEXT_TOKEN_BUDGET=10000
QUERY_SOURCE_MAX_LINES_PER_FILE=120
QUERY_SOURCE_MAX_TOTAL_LINES=400
QUERY_ANSWER_PROVIDER=nemotron        # nemotron | gemini
QUERY_FALLBACK_TO_GEMINI=true
CHAT_GENERATION_TIMEOUT_SECONDS=120
NEMOTRON_TIER_QUERY_ANSWER=fast       # fast | reasoning

# Jev Prompt Router & Hypothesis Pipeline
JEV_PROMPT_MIN_CONFIDENCE=0.75
JEV_DECISION_TTL_SECONDS=300
HYPOTHESIS_PER_TENET_CAP=10
HYPOTHESIS_RATE_LIMIT_PER_MINUTE=10
NEMOTRON_TIER_JEV_PROMPT=fast
NEMOTRON_TIER_GENERATOR=deep
NEMOTRON_TIER_VERIFIER=fast

